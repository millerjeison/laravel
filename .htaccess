# ─────────────────────────────────────────────────────────────────────
#  Construmateriales JF · hosting compartido (Hostinger)
#  El proyecto completo vive dentro de public_html y TODO se envía a la
#  carpeta public/. Así la tienda abre en la raíz del dominio, sin /public,
#  y nadie puede abrir .env, el código ni la base de datos desde el navegador.
# ─────────────────────────────────────────────────────────────────────
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Laravel no usa la sesión nativa de PHP (PHPSESSID): ninguna petición legítima la trae.
    RewriteCond %{HTTP_COOKIE} (^|;\s*)PHPSESSID= [NC,OR]
    RewriteCond %{QUERY_STRING} (^|&)PHPSESSID= [NC]
    RewriteRule ^ - [F,L]

    # Una sola versión del sitio, sin "www"
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

    # Siempre https (también detrás del CDN de Hostinger)
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Todo lo atiende la carpeta public/ (su propio .htaccess redirige las direcciones con /public/)
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Respaldo por si mod_rewrite no estuviera disponible: bloquear archivos sensibles
<FilesMatch "^(\.env.*|composer\.(json|lock)|package(-lock)?\.json|artisan|boost\.json|.*\.sqlite(-wal|-shm|-journal)?)$">
    Require all denied
</FilesMatch>
